# Copy to .env (never commit .env). All values below are placeholders.

# PostgreSQL (Supabase). Use the Supabase *session pooler* URI for IPv4 hosts such as Render.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Gemini (server-side only; never exposed to the browser)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# Structured JSON logs (also written to stdout). Ephemeral on Render unless a persistent disk is mounted.
LOG_FILE_PATH=/tmp/relay.jsonl
LOG_LEVEL=INFO

# Seed the synthetic demo workspace on startup when the database is empty.
SEED_DEMO_DATA=true
